{
  "name": "JS-modules",
  "license": "MIT",
  "copyright": "JNFoo",
  "repository": "https://github.com/JNFoo/JS-modules",
  "pages": "https://jnfoo.github.io/JS-modules/",
  "origin": "Extracted from Apple Press, https://github.com/JNFoo/apple-press (play: https://jnfoo.github.io/apple-press/), and Fancy, the Banana, https://github.com/JNFoo/fancy-banana (play: https://jnfoo.github.io/fancy-banana/)",
  "modules": [
    {
      "id": "stage-curtains",
      "global": "StageCurtains",
      "summary": "Velvet stage curtains that slide shut over a page, then fly open.",
      "file": "modules/stage-curtains/stage-curtains.js",
      "readme": "modules/stage-curtains/README.md",
      "demo": "modules/stage-curtains/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "save-kit",
      "global": "SaveKit",
      "summary": "Safe localStorage saves, backup slot, checksummed copy-paste save codes.",
      "file": "modules/save-kit/save-kit.js",
      "readme": "modules/save-kit/README.md",
      "demo": "modules/save-kit/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "hold-press",
      "global": "HoldPress",
      "summary": "Hold-to-repeat for buttons that survives Android Chrome pointercancel.",
      "file": "modules/hold-press/hold-press.js",
      "readme": "modules/hold-press/README.md",
      "demo": "modules/hold-press/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "env-probes",
      "global": "EnvProbes",
      "summary": "Detects privacy modes that round timers, scramble canvas read-back or block storage.",
      "file": "modules/env-probes/env-probes.js",
      "readme": "modules/env-probes/README.md",
      "demo": "modules/env-probes/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "fx-governor",
      "global": "FxGovernor",
      "summary": "Steps visual effects down when the device cannot keep up; never back up behind the player.",
      "file": "modules/fx-governor/fx-governor.js",
      "readme": "modules/fx-governor/README.md",
      "demo": "modules/fx-governor/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "fly-to-mini",
      "global": "FlyToMini",
      "summary": "A big element scrolls away and a copy flies to its sticky mini version (and back).",
      "file": "modules/fly-to-mini/fly-to-mini.js",
      "readme": "modules/fly-to-mini/README.md",
      "demo": "modules/fly-to-mini/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "sticker-text",
      "global": "StickerText",
      "summary": "Die-cut sticker lettering in plain CSS text-shadow rings, no images.",
      "file": "modules/sticker-text/sticker-text.js",
      "readme": "modules/sticker-text/README.md",
      "demo": "modules/sticker-text/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "idle-core",
      "global": "IdleCore",
      "summary": "Tested maths for idle/clicker games: costs, milestones, away income, boost queue, number format.",
      "file": "modules/idle-core/idle-core.js",
      "readme": "modules/idle-core/README.md",
      "demo": "modules/idle-core/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "frame-kit",
      "global": "EvenDt, QualityGovernor, JobPump",
      "summary": "Frame pacing for canvas games: even-dt smooths the frame time, quality-governor steps effects down and back up, job-pump spreads heavy jobs across frames.",
      "file": "modules/frame-kit/",
      "readme": "modules/frame-kit/README.md",
      "demo": "modules/frame-kit/demo.html",
      "dependencies": "none",
      "formats": "browser globals, CommonJS (module.exports) per file",
      "files": [
        "even-dt.js",
        "quality-governor.js",
        "job-pump.js"
      ]
    },
    {
      "id": "sprite-baker",
      "global": "SpriteBaker",
      "summary": "Tiny software 3D rasterizer that bakes shaded sprites to canvases once at load.",
      "file": "modules/sprite-baker/sprite-baker.js",
      "readme": "modules/sprite-baker/README.md",
      "demo": "modules/sprite-baker/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "pad-nav",
      "global": "PadNav",
      "summary": "Gamepad API to DOM focus: move through buttons and menus with a controller, no game code.",
      "file": "modules/pad-nav/pad-nav.js",
      "readme": "modules/pad-nav/README.md",
      "demo": "modules/pad-nav/demo.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "lzma-decode",
      "global": "lzmaDecode",
      "summary": "Small readable LZMA1 decoder (ES5), tested against Python's lzma. Browsers can only unpack gzip and deflate natively.",
      "file": "modules/lzma-decode/lzma-decode.js",
      "readme": "modules/lzma-decode/README.md",
      "demo": "tools/lzma-pack/example/packed-base64.html",
      "dependencies": "none",
      "formats": "browser global, CommonJS (module.exports)"
    },
    {
      "id": "cartoon-3d-kit",
      "summary": "A written style guide plus demo for the soft, glossy cartoon 3D look done in plain CSS/SVG/canvas.",
      "file": "modules/cartoon-3d-kit/STYLE-GUIDE.md",
      "demo": "modules/cartoon-3d-kit/demo.html",
      "dependencies": "none"
    }
  ],
  "tools": [
    {
      "id": "fuzz-play",
      "summary": "Random-play robot with invariants (Playwright), plus an in-page version for Firefox.",
      "folder": "tools/fuzz-play",
      "readme": "tools/fuzz-play/README.md"
    },
    {
      "id": "marionette-lite",
      "summary": "Drive Firefox from Python with the standard library only.",
      "folder": "tools/marionette-lite",
      "readme": "tools/marionette-lite/README.md"
    },
    {
      "id": "single-file-tools",
      "summary": "Font subsetting, safe inline-SVG tightening and a Zopfli self-extracting packer for one-file games.",
      "folder": "tools/single-file-tools",
      "readme": "tools/single-file-tools/README.md"
    },
    {
      "id": "lzma-pack",
      "summary": "Packs one HTML file into a smaller self-unpacking file with LZMA and a hash check (Python 3 standard library).",
      "folder": "tools/lzma-pack",
      "readme": "tools/lzma-pack/README.md"
    },
    {
      "id": "fuzz-kit",
      "summary": "Seeded, reproducible random-input fuzzer engine with weighted operations, invariants and liveness checks; Playwright and Puppeteer runners; test-hook stripper.",
      "folder": "tools/fuzz-kit",
      "readme": "tools/fuzz-kit/README.md"
    }
  ],
  "related": {
    "repository": "https://github.com/JNFoo/p-see-story-editor",
    "pages": "https://jnfoo.github.io/p-see-story-editor/",
    "note": "Story packages live with the editor they are generated from.",
    "packages": [
      {
        "id": "story-format",
        "summary": "Create, clean, import and export interactive stories as JSON, with a JSON Schema.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/story-format/README.md"
      },
      {
        "id": "story-check",
        "summary": "Exact checker for branching stories with items, numbers and dice: dead ends and endings no player can reach.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/story-check/README.md"
      },
      {
        "id": "story-player",
        "summary": "Build one offline HTML game from a story, or play a story from code or a terminal.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/story-player/README.md"
      },
      {
        "id": "story-map",
        "summary": "Layered, arc and matrix drawings of a story graph (SVG) and seeded simulated players.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/story-map/README.md"
      },
      {
        "id": "zip-page",
        "summary": "Wrap a finished HTML page into a smaller page that unzips itself, with a pure-JS inflater fallback.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/zip-page/README.md"
      },
      {
        "id": "qa-kit",
        "summary": "Tiered test runner and a Playwright-style API over WebDriver BiDi for stock Firefox; seeded random-story generator.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/qa-kit/README.md"
      },
      {
        "id": "ai-collab-kit",
        "summary": "A written process and templates for a person and an AI assistant building software together.",
        "readme": "https://github.com/JNFoo/p-see-story-editor/blob/main/packages/ai-collab-kit/README.md"
      }
    ]
  }
}
